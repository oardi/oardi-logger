{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": false,
		"noEmitOnError": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"types": []
	},
	"include": ["src/**/*.ts"]
}
